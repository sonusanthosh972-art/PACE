{
  "name": "paisa-pulse",
  "private": true,
  "description": "Personal spending tracker for India (monorepo root). Each app manages its own dependencies.",
  "scripts": {
    "check": "scripts/check.sh",
    "check:android": "scripts/check.sh --android",
    "mobile": "npm --prefix apps/mobile run start",
    "android": "npm --prefix apps/mobile run android",
    "api": "dotnet run --project apps/api/src/PaisaPulse.Api",
    "admin": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
