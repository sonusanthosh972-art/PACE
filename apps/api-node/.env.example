# Copy to .env (git-ignored) and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DATABASE=paisapulse
JWT_SECRET=replace-with-at-least-32-char-random-secret
# Shared secret for the admin dashboard (also set in apps/admin/.env.local). Leave empty to disable admin endpoints.
ADMIN_API_KEY=
PORT=5080
HOST=0.0.0.0
# Comma-separated browser origins; leave empty to keep CORS off.
CORS_ORIGINS=
# Reverse proxies in front of the API (set to 1 on Render), so rate limits use the real client IP.
TRUST_PROXY_HOPS=0
# Password-reset and email-verification codes, sent with Resend (https://resend.com).
# Without these, codes are printed to the console in development; in production reset is disabled.
RESEND_API_KEY=
MAIL_FROM=
# Optional error reporting (https://sentry.io). Empty = off.
SENTRY_DSN=
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
# Keep a free Render instance awake by pinging its own public URL every 10 minutes.
# Uses RENDER_EXTERNAL_URL automatically on Render; set KEEP_ALIVE_URL elsewhere, or KEEP_ALIVE=false to turn off.
KEEP_ALIVE=true
KEEP_ALIVE_URL=
# Minutes between pings (1–14, default 10). Render sleeps after 15 idle minutes.
KEEP_ALIVE_INTERVAL_MINUTES=10
# Other free backends this service should keep awake too (comma-separated base URLs).
KEEP_ALIVE_EXTRA_URLS=
